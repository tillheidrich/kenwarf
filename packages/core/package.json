{
  "name": "@kern/core",
  "version": "0.1.0",
  "description": "Kern Engine: Markdown-Wissensordner mit git, Index (FTS5 + Vektor), belegte Antworten, Eingang mit Freigabe",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "pruefung/oeffentlich"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/kopiere-seed.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test",
    "pruefung": "vitest run pruefung",
    "eval": "vitest run pruefung"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "age-encryption": "^0.3.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "diff": "^9.0.0",
    "linkedom": "^0.18.14",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "simple-git": "^4.0.2",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "undici": "^7.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "jszip": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
