{
  "name": "@kern/import-outline",
  "version": "0.1.0",
  "description": "Kern: Import aus Outline (Markdown-/OKF-/JSON-Export, API mit Token, MCP-Abzug), über die öffentliche Schnittstelle von @kern/core",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kern-import-outline": "dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@kern/core": "0.1.0",
    "jszip": "^3.10.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
