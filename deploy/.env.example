# Vorlage: kopieren nach deploy/.env und anpassen. .env nie ins git.
KERN_BETRIEB=Mein Betrieb
KERN_ADMIN=admin
# Leer lassen: Erstpasswort wird erzeugt und einmal im Log gezeigt.
KERN_ADMIN_PASSWORT=
# Leer lassen: wird beim ersten Start erzeugt und im Datenordner (.kern/secret) abgelegt.
KERN_SECRET=

# Mit Domain und TLS (Profil "tls"):
#KERN_DOMAIN=wissen.example.de
#ACME_MAIL=it@example.de
#KERN_SECURE_COOKIE=1
#KERN_TRUST_PROXY=1

# KI-Anbieter. Beispiele (URLs aus den Anbieter-Dokus, abgerufen 24.10.2026; Modellnamen vor Nutzung in der Modellliste des Anbieters prüfen):
# Mistral (Paris):            KERN_PROVIDER=openai  KERN_PROVIDER_URL=https://api.mistral.ai/v1  KERN_CHAT_MODELL=mistral-medium-latest  KERN_EMBED_MODELL=mistral-embed
# IONOS AI Model Hub (Berlin): KERN_PROVIDER=openai  KERN_PROVIDER_URL=https://openai.inference.de-txl.ionos.com/v1  KERN_EMBED_MODELL=BAAI/bge-m3
# STACKIT (eu01):             KERN_PROVIDER=openai  KERN_PROVIDER_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
# Scaleway (Paris):           KERN_PROVIDER=openai  KERN_PROVIDER_URL=https://api.scaleway.ai/v1  KERN_EMBED_MODELL=bge-multilingual-gemma2
# OVHcloud AI Endpoints:      KERN_PROVIDER=openai  KERN_PROVIDER_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1  KERN_EMBED_MODELL=Qwen3-Embedding-8B
# Ollama im Verbund:          KERN_PROVIDER=ollama  KERN_PROVIDER_URL=http://ollama:11434  KERN_CHAT_MODELL=qwen3:8b  KERN_EMBED_MODELL=bge-m3
KERN_PROVIDER=mock
KERN_PROVIDER_URL=
KERN_PROVIDER_KEY=
KERN_CHAT_MODELL=
KERN_EMBED_MODELL=
